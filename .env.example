# Maps is read from ../API.txt; put your Gemini key in a private .env file.
# Keep actual secrets in .env, never in a VITE_ variable or a committed file.
# GEMINI_API_KEY=
# GOOGLE_MAPS_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# API_KEYS_FILE=C:\path\to\API.txt
# DATA_DIR=C:\path\to\private-data
# Enable only behind HTTPS:
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000
